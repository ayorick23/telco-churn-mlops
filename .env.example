# ============================================================
# .env.example — Template de variables de entorno.
# Copiar a .env y completar con valores reales.
# .env está en .gitignore — NUNCA commitear credenciales.
# ============================================================

# ── DagsHub / MLflow ──────────────────────────────────────
# URL del servidor MLflow hosteado por DagsHub.
# Formato: https://dagshub.com/<tu-usuario>/<nombre-repo>.mlflow
MLFLOW_TRACKING_URI=https://dagshub.com/YOUR_USERNAME/telco-churn-mlops.mlflow

# Credenciales de DagsHub (mismas para DVC remote y MLflow).
# Obtener en: DagsHub → Settings → Access Tokens
MLFLOW_TRACKING_USERNAME=YOUR_DAGSHUB_USERNAME
MLFLOW_TRACKING_PASSWORD=YOUR_DAGSHUB_TOKEN

# ── Configuración general ────────────────────────────────
# Ambiente de ejecución (development | staging | production)
ENV=development
