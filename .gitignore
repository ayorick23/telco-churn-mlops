# ── Python ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Distribución / empaquetado
*.egg-info/
dist/
build/
*.egg

# ── Entornos virtuales ────────────────────────────────────────────────
.venv/
venv/
.uv/

# ── Testing y cobertura ───────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# ── Type checking ────────────────────────────────────────────────────
.mypy_cache/

# ── Linting ──────────────────────────────────────────────────────────
.ruff_cache/

# ── Jupyter ──────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── MLflow (local) ────────────────────────────────────────────────────
# Los artefactos y runs se loggean a DagsHub, no al repo local.
# Si alguien corre MLflow localmente sin configurar el tracking URI,
# estos directorios se crean en la raíz del proyecto.
mlruns/
mlartifacts/

# ── CatBoost ──────────────────────────────────────────────────────────
# Logs de entrenamiento que CatBoost escribe en el cwd por defecto.
catboost_info/

# ── DVC ──────────────────────────────────────────────────────────────
# config.local tiene las credenciales de DagsHub (usuario + token).
# NUNCA debe commitearse.
.dvc/config.local
# El cache de DVC vive localmente, no en git.
.dvc/cache/
# tmp de DVC
.dvc/tmp/

# ── Datos (gestionados por DVC, no por git) ───────────────────────────
# data/ es gestionado por DVC: los archivos reales se suben a DagsHub,
# los .dvc files (hashes) sí van a git.
# Nota: dvc add agrega automáticamente cada archivo a su .gitignore local.
# Esta línea es una salvaguarda general.
#data/raw/
data/processed/
data/features/
data/batches/

# models/*.pkl y models/*.json: el contenido real se sube a DagsHub vía DVC.
# lightgbm_pipeline.pkl y best_params.json se trackean vía el stage
# train_model (dvc.yaml + dvc.lock, análogo a data/processed/);
# champion_pipeline.pkl se trackea aparte vía `dvc add` (ADR 0012, no es
# output de un stage) — su .pkl.dvc SÍ va a git, análogo a
# data/raw/telco.csv.dvc.
models/*.pkl
models/*.json

# ── Reportes de monitoreo (Fase 5) ─────────────────────────────────────
# El HTML/JSON de Evidently por batch ya se loguea a MLflow (fuente de
# verdad, ver ADR 0011) y pesa varios MB por archivo — no va a git. Solo se
# versiona el resumen cross-batch (CSV/MD), igual criterio que
# reports/model_selection_*.
reports/monitoring/*.html
reports/monitoring/*.json

# ── Variables de entorno / secretos ──────────────────────────────────
.env
.env.local
.env.*.local
# .env.example SÍ va a git (es un template sin valores reales)

# ── Streamlit ────────────────────────────────────────────────────────
.streamlit/secrets.toml

# ── OS ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDEs ──────────────────────────────────────────────────────────────
.vscode/settings.json
.vscode/*.code-workspace
.idea/
*.swp
*.swo
